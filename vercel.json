{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'skip install (dist/ is prebuilt)'",
  "buildCommand": "echo 'skip build (dist/ is prebuilt; run python3 scripts/build_dist.py locally)'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/table", "destination": "/table.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
